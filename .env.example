# PriceScout — Environment Variables
# Copy this to .env and fill in your values

# Telegram bot token (get from @BotFather on Telegram)
TELEGRAM_TOKEN=

# Groq API key (free tier, no credit card needed)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# Backup Groq API key (tried automatically if primary fails)
GROQ_API_KEY_BACKUP=

# Cloudflare Worker proxy URL (required for Vercel deployment)
# Deploy worker/index.js to Cloudflare Workers (free: 100K req/day)
# Example: https://pricescout-proxy.YOUR_SUBDOMAIN.workers.dev
PROXY_URL=

# Rate limiting — minimum seconds between calls to the same domain
MIN_INTERVAL_SEC=2.0

# Cache TTL in seconds (default: 6 hours)
CACHE_TTL_SEC=21600
